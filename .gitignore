# vscode
.vscode 

# Intellij
*.iml
.idea

# my own stuff...
video-scripts

# npm
node_modules

# Don't include the compiled main.js file in the repo.
# They should be uploaded to GitHub releases instead.
main.js

# Exclude sourcemaps
*.map

# obsidian
data.json

# Icon packs downloaded at runtime — served from the packs-v1 tag, never committed
icon-packs/

# Material Symbols webfonts cached at runtime — fetched from fonts.gstatic.com on
# first use of the picker's Material grid. A cache, never a dependency: Google
# reissues the file whenever the icon set changes, so a pinned copy would go stale.
icon-fonts/

# local agent state
.serena/
graphify-out/

# .claude is local-only, except the release skill, which is part of the
# project's release process and belongs in version control.
.claude/*
!.claude/skills/
.claude/skills/*
!.claude/skills/release/

# Exclude macOS Finder (System Explorer) View States
.DS_Store
